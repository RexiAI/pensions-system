{
  "name": "pensions-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/verify-derived.ts && tsx scripts/check-content-scope.ts && tsx scripts/check-public-vocabulary.ts && tsx scripts/check-scenario-traceability-3digit.ts && tsx scripts/check-plain-language.ts",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "compute": "tsx scripts/compute.ts",
    "ingest": "tsx scripts/ingest-snapshots.ts && tsx scripts/ingest-population-projection.ts",
    "verify:derived": "tsx scripts/verify-derived.ts",
    "check:client-secrets": "tsx scripts/check-client-secrets.ts",
    "sitemap:check": "tsx scripts/check-sitemap.ts",
    "check:public-vocabulary": "tsx scripts/check-public-vocabulary.ts",
    "check:content-scope": "tsx scripts/check-content-scope.ts",
    "check:plain-language": "tsx scripts/check-plain-language.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
